# Copy this file to DSWT-workshop/credentials.env (this directory — not the
# repo root; DSWT-workshop is fully standalone and keeps its own secrets).
# Never put real values in this file itself; only in your own credentials.env,
# which is gitignored.
#
#   cp credentials.env.example credentials.env
#   chmod 600 credentials.env

# Your own Confluent Cloud account's API key/secret (Cloud resource scope).
# `uv run python scripts/cli.py up` can generate these for you if you're logged
# in with `confluent login` — just answer "y" when it asks.
TF_VAR_confluent_cloud_api_key=
TF_VAR_confluent_cloud_api_secret=

# Tags the Confluent environment it creates. Use your own email.
TF_VAR_owner_email=

# The Gemini API key your instructor/organizer gave you.
# Backs the LAB 4 pit_strategy_agent.
TF_VAR_gemini_api_key=
